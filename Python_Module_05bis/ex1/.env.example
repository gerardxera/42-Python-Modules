# Configuración del entorno (development / production)
MATRIX_MODE=development

# Cadena de conexión a la base de datos
DATABASE_URL=sqlite:///local.db

# Clave de acceso a la API externa (valor de ejemplo)
API_KEY=your_secret_api_key_here

# Nivel de detalle de los logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Endpoint de la red remota
ZION_ENDPOINT=http://localhost:8000
